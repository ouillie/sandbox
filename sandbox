#!/usr/bin/env bash

set -euo pipefail

# Iterate up the directory tree, looking for sibling directories named `.sandbox`.
# In each of those directories, process the following files:
# - `proxy.py`: Loaded as an mitmproxy addon.
# - `configure.sh`: Settings configuration for the sandbox.
proxy_addon_mounts=()
configure_paths=()
directory="${PWD}"
index=1
configured='false'
while
  # Strip a trailing slash; should only affect the root directory (`/`).
  directory=${directory%/}

  configure_path="${directory}/.sandbox/configure.sh"
  if [ -f "${configure_path}" ]
  then
    echo "Using configuration: ${configure_path}" >&2
    configured='true'
    configure_paths+=("${configure_path}")
  fi

  proxy_addon="${directory}/.sandbox/proxy.py"
  if [ -f "${proxy_addon}" ]
  then
    echo "Using proxy addon: ${proxy_addon}" >&2
    configured='true'
    proxy_addon_mounts+=(--volume="${proxy_addon}":"/root/addons/$(printf '%03d' "${index}").py":ro)
  fi

  [ -n "${directory}" ]
do
  directory="$(dirname "${directory}")"
  index=$(( index + 1 ))
done
if [[ "${configured}" != 'true' ]]
then
  echo "Using default configuration"
fi

mitmproxy_confdir="$(mktemp -d)"
mitmproxy_host_ca_path="${mitmproxy_confdir}/mitmproxy-ca.pem"
mitmproxy_host_ca_cert_path="${mitmproxy_confdir}/mitmproxy-ca-cert.pem"
mitmproxy_ca_path='/root/.mitmproxy/mitmproxy-ca-cert.pem'
podman run \
  --rm \
  --volume="${mitmproxy_confdir}":/root/.mitmproxy:rw \
  mitmproxy/mitmproxy:latest \
  bash -c '
    openssl req -x509 \
      -newkey rsa:2048 \
      -noenc -batch -quiet \
      -days 365 \
      -keyout /root/.mitmproxy/mitmproxy-ca.key \
      -out /root/.mitmproxy/mitmproxy-ca-cert.pem \
      -subj "/O=mitmproxy/CN=mitmproxy" \
      -addext "basicConstraints=critical,CA:TRUE" \
      -addext "keyUsage=critical,keyCertSign,cRLSign"
    cat /root/.mitmproxy/mitmproxy-ca.key /root/.mitmproxy/mitmproxy-ca-cert.pem \
      > /root/.mitmproxy/mitmproxy-ca.pem
  '
export PROXY_CA_CERT_PEM="$(< "${mitmproxy_host_ca_cert_path}")"

# Set all the configurable settings to defaults before running the configure scripts.

# Sandbox container image.
SANDBOX_IMAGE="${SANDBOX_IMAGE:-debian:latest}"
# Sandbox container username.
SANDBOX_USER="${SANDBOX_USER:-root}"
# Sandbox user's home directory.
if [[ "${SANDBOX_USER}" = 'root' ]]
then
  SANDBOX_HOME="${SANDBOX_HOME:-/root}"
else
  SANDBOX_HOME="${SANDBOX_HOME:-/home/${SANDBOX_USER}}"
fi
# Working directory in the sandbox at entry.
# By default, use the current working directory on the host.
# If that path starts with the host's `${HOME}` path,
# swap out that prefix for `${SANDBOX_HOME}`.
if [ -z "${SANDBOX_WORKDIR+.}" ]
then
  # Avoid mistakenly substituting the home prefix
  # when e.g. the working directory is `/home/nameless` and the home directory is `/home/name`.
  case "${PWD}" in
    "${HOME}"|"${HOME}"/*)
      SANDBOX_WORKDIR="${PWD/#"${HOME}"/"${SANDBOX_HOME}"}"
      ;;
    *)
      SANDBOX_WORKDIR="${PWD}"
      ;;
  esac
fi
# Array of mount points to bind-mount from the host into the sandbox,
# using Podman's `<host-path>:<guest-path>[:<mode>]` syntax,
# where `<mode>` can be `ro`, `rw`, or `O` (overlay).
# By default, mount the host's `${HOME}` directory to `${SANDBOX_HOME}` as an overlay,
# and mount the host's working directory to the guest's working directory read-write.
# If the host's working directory is the home directory, mount it read-write.
if [ -z "${SANDBOX_MOUNTS[@]+.}" ]
then
  if [[ "${SANDBOX_WORKDIR}" = "${SANDBOX_HOME}" ]]
  then
    declare -a SANDBOX_MOUNTS=(
      "${HOME}":"${SANDBOX_HOME}":rw
    )
  else
    declare -a SANDBOX_MOUNTS=(
      "${HOME}":"${SANDBOX_HOME}":O
      "${PWD}":"${SANDBOX_WORKDIR}":rw
    )
  fi
fi
# Array of environment variables to set in the sandbox
# using Podman's `NAME=VALUE` or simply `NAME` syntax.
# By default, set various environment variables to trust the proxy's ephemeral CA in most apps,
# since the proxy intercepts all network traffic, terminating TLS if necessary.
# Also set `IS_SANDBOX=1`
# which is required by Claude Code to run as root with `--dangerously-skip-permissions`.
# https://github.com/anthropics/claude-code/issues/9184
if [ -z "${SANDBOX_ENV[@]+.}" ]
then
  declare -a SANDBOX_ENV=(
    SSL_CERT_FILE="${mitmproxy_ca_path}"
    CURL_CA_BUNDLE="${mitmproxy_ca_path}"
    GIT_SSL_CAINFO="${mitmproxy_ca_path}"
    CARGO_HTTP_CAINFO="${mitmproxy_ca_path}"
    NODE_EXTRA_CA_CERTS="${mitmproxy_ca_path}"
    REQUESTS_CA_BUNDLE="${mitmproxy_ca_path}"
    IS_SANDBOX=1
  )
fi
# Array of environment variables to set in the proxy, similar to `SANDBOX_ENV`.
# Empty by default.
if [ -z "${PROXY_ENV[@]+.}" ]
then
  declare -a PROXY_ENV=()
fi

# Process the user's configuration scripts from root to leaf.
for (( i=${#configure_paths[@]}-1; i>=0; i-- ))
do
  source "${configure_paths[i]}" || {
    configure_status=$?
    echo "Failed while evaluating '${configure_paths[i]}'" >&2
    exit $configure_status
  }
done

function cleanup-proxy-confdir {
  rm -rf "${mitmproxy_confdir}"
}
trap cleanup-proxy-confdir EXIT

# The workload's network is internal: it has no route to the internet of its own,
# so the proxy (its only neighbor, dual-homed onto the egress network) is the only way out.
wireguard_network="$(podman network create --internal)"
egress_network="$(podman network create)"

function cleanup-networks {
  podman network rm "${wireguard_network}" "${egress_network}" > /dev/null 2>&1 || true
  cleanup-proxy-confdir
}
trap cleanup-networks EXIT

# `mitmweb` always requires auth (setting an empty password just makes it generate a random one).
# Pin a known password and let the launcher pass it as `?token=` to skip the prompt.
mitmweb_password='sandbox'
proxy_container="$(
  podman run \
    --detach --rm \
    --user=root \
    --network="${wireguard_network}" \
    --network="${egress_network}" \
    --volume="${mitmproxy_confdir}":/root/.mitmproxy:rw \
    "${proxy_addon_mounts[@]}" \
    --publish=127.0.0.1::8081 \
    "${PROXY_ENV[@]/#/--env=}" \
    mitmproxy/mitmproxy:latest \
    bash -c '
      arguments=(
        --mode=wireguard
        --set=web_password="${0}"
        --web-host=0.0.0.0
        --no-web-open-browser
        # Use the `Host` header to construct URLs for display.
        --set=showhost=true
      )
      shopt -s nullglob
      for script in "${HOME}"/addons/*.py
      do
        arguments+=(--scripts="${script}")
      done
      exec mitmweb "${arguments[@]}"
    ' "${mitmweb_password}"
)"

function cleanup-proxy-container {
  podman rm -f "${proxy_container}" > /dev/null 2>&1 || true
  cleanup-networks
}
trap cleanup-proxy-container EXIT

# Wait for mitmproxy to generate its CA and WireGuard keys.
wireguard_key_path='/root/.mitmproxy/wireguard.conf'
timeout=5
start=$(date +%s)
until podman exec "${proxy_container}" test -f "${wireguard_key_path}" 2> /dev/null
do
  sleep 0
  now=$(date +%s)
  if (( now - start > timeout ))
  then
    echo "Failed to start proxy pod after ${timeout} seconds" >&2
    exit 1
  fi
done

mitmweb_url="http://$(podman port "${proxy_container}" 8081)/?token=${mitmweb_password}"
# Use an OSC-8 hyperlink to print the network monitor URL.
# https://gist.github.com/egmontkob/eb114294efbcd5adb1944c9f3cb5feda
printf 'Network monitor: \e]8;;%s\e\\%s\e]8;;\e\\\n' "${mitmweb_url}" "${mitmweb_url}" >&2
if [ -n "${AUTO_OPEN_NETWORK_MONITOR+.}" ]
then
  if command -v xdg-open > /dev/null
  then
    xdg-open "${mitmweb_url}"
  elif command -v open > /dev/null
  then
    open "${mitmweb_url}"
  fi
fi

# The proxy's address is the WireGuard endpoint.
# mitmproxy stores both private keys,
# so derive the server's public key (which the workload's peer needs).
proxy_ip="$(
  podman inspect "${proxy_container}" \
    --format="{{(index .NetworkSettings.Networks \"${wireguard_network}\").IPAddress}}"
)"
read -r server_key client_key < <(
  podman exec "${proxy_container}" python -c '
from json import load
from mitmproxy_rs import wireguard

with open("/root/.mitmproxy/wireguard.conf") as configuration_file:
    configuration = load(configuration_file)
print(wireguard.pubkey(configuration["server_key"]), configuration["client_key"])
'
)

# A pod owns the sandbox' network namespace.
# A throwaway container will configure the WireGuard tunnel inside the pod before the sandbox starts.
declare -a arguments=()
if [ -n "${SANDBOX_HOSTNAME:-}" ]
then
  arguments+=(--hostname="${SANDBOX_HOSTNAME}")
fi
sandbox_pod="$(podman pod create --network="${wireguard_network}" "${arguments[@]}")"
sandbox_hostname="${SANDBOX_HOSTNAME:-$(podman pod inspect --format '{{.Name}}' "${sandbox_pod}")}"

function cleanup-pod {
  podman pod rm -f "${sandbox_pod}" > /dev/null 2>&1 || true
  cleanup-proxy-container
}
trap cleanup-pod EXIT

# Build an image with basic tools to set up the network for the sandbox.
# This adds a single layer to the already-cached `mitmproxy` image we just used,
# so it should be somewhat cheap on the initial run, and very cheap on subsequent runs.
network_tools_image="$(
  podman build --quiet --file - <<EOF
FROM mitmproxy/mitmproxy:latest
RUN apt-get update \\
  && apt-get install --yes --no-install-recommends iproute2 wireguard-tools \\
  && rm -rf /var/lib/apt/lists/*
EOF
)"

# Set up the WireGuard tunnel to the proxy in the sandbox pod's namespace.
podman run \
  --rm \
  --pod="${sandbox_pod}" \
  --cap-add=NET_ADMIN \
  "${network_tools_image}" \
  bash -c '
    ip link add wg0 type wireguard
    wg set wg0 private-key <(echo "${1}") peer "${2}" endpoint "${3}:51820" allowed-ips 0.0.0.0/0
    ip address add 10.0.0.1/32 dev wg0
    ip link set wg0 up
    ip route replace default dev wg0
  ' "${0}" "${client_key}" "${server_key}" "${proxy_ip}"

# Set the special `PROXY_NAME` env var in the sandbox to the short name of the proxy container.
# This enables usability wins like including the name in the shell prompt.
SANDBOX_ENV+=(PROXY_NAME="$(podman inspect --format '{{.Name}}' "${proxy_container}")")

declare -a arguments=()
if [ -t 0 ]
then
  arguments+=(--tty)
fi

# Join the configured namespace and run the command. The CA env vars cover runtimes
# (Node, Python requests, ...) that ignore the system store; the copy below covers
# those that only read the default OpenSSL bundle.
podman run \
  --interactive --rm \
  "${arguments[@]}" \
  --name="${sandbox_hostname}" \
  --pod="${sandbox_pod}" \
  --volumes-from="${proxy_container}":ro \
  --user="${SANDBOX_USER}" \
  --workdir="${SANDBOX_WORKDIR}" \
  "${SANDBOX_MOUNTS[@]/#/--volume=}" \
  "${SANDBOX_ENV[@]/#/--env=}" \
  "${SANDBOX_IMAGE}" \
  bash -c '
    echo "nameserver 10.0.0.53" > /etc/resolv.conf

    for ca_certificates in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt
    do
      if [ -f "${ca_certificates}" ]
      then
        cp "${1}" "${ca_certificates}"
      fi
    done

    shift
    if (( $# == 0 ))
    then
      exec "${SHELL:-/usr/bin/bash}"
    else
      exec "$@"
    fi
  ' "${0}" "${mitmproxy_ca_path}" "$@"
